# S³ Sportrail Scouting — Environment variables
#
# Copy this file to `.env.local` for local dev, or set these in Vercel
# → Project Settings → Environment Variables for production.
#
# The anon key is safe to expose in the client (it's gated by RLS on the DB).
# NEVER put the service_role key anywhere client-side.

NEXT_PUBLIC_SUPABASE_URL=https://amjzgfwndngdilvebaxz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Dark launch feature flag.
# Set to "true" only when you want /login to be reachable by real users.
NEXT_PUBLIC_ENABLE_AUTH=false

# ── Formador feedback (server-side only) ──────────────────────────────────
# Required for /api/feedback to look up student emails and send notifications.

# Supabase service role key — Supabase dashboard → Settings → API → service_role key
# NEVER expose this in client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend API key — https://resend.com → API Keys
RESEND_API_KEY=re_your_key_here

# From address for feedback emails (must be a verified domain in Resend)
RESEND_FROM_EMAIL=Sportrail <noreply@sportrail.pt>
